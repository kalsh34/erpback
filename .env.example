PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/vitalpayroll
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
NODE_ENV=development
# First-run administrator auto-created only when the database has no admin user yet
BOOTSTRAP_ADMIN_EMAIL=admin@vitalpayroll.com
BOOTSTRAP_ADMIN_PASSWORD=admin123
# Browser origins allowed to call this API (comma separated). "*" = allow all.
# Restrict this to your frontend origin in production, e.g.
# CORS_ORIGIN=https://my-frontend.onrender.com,http://localhost:3000
CORS_ORIGIN=*
# ---------------------------------------------------------------------------
# Deployed API: https://erpback-tnsv.onrender.com
# On Render set the variables above in the dashboard (Environment tab) instead
# of committing them here; PORT is injected by Render automatically.
# The frontend points at that URL via VITE_API_URL in Fronterp/.env
# ---------------------------------------------------------------------------
